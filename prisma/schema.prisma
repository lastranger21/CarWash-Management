// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "postgresql"
}

model User {
 id           Int       @id @default(autoincrement())
 name         String 
 email        String    @unique
 password     String
 role         Role      @default(STAFF)
 createdAt    DateTime  @default(now())

 orders              Order[]
 paymentsReceived    Payment[]            
 statusChanges       OrderStatusHistory[] 
}

model Customer {
  id            Int       @id @default(autoincrement())
  name          String
  phone         String    @db.VarChar(16)
  createdAt     DateTime  @default(now())
  membership Membership?
  orders     Order[]
}

model Membership{
  id              Int      @id @default(autoincrement())
  
  memberCode      String   @unique
  discountPercent Decimal  @db.Decimal(5, 2) @default(10.00)
  isActive        Boolean  @default(true)
  joinedAt        DateTime @default(now())
  customerId      Int   @unique 
  customer Customer @relation(fields: [customerId], references: [id])
}

model Service {
  id Int @id @default(autoincrement())
  name String
  price Int 
  isActive Boolean @default(true)

  orderItems  OrderItem[]
}

model Order {
  id Int @id @default(autoincrement())
  orderCode String @unique
  customerId Int 
  vehiclePlate String 
  createdById Int
  status OrderStatus @default(PENDING)
  paymentStatus PayStatus            @default(UNPAID)
  subtotal      Int              
  discount      Decimal              @db.Decimal(12, 2) @default(10.00)
  total         Int              
  createdAt     DateTime             @default(now())
  customer      Customer             @relation(fields: [customerId], references: [id])
  createdByUser User                 @relation(fields: [createdById], references: [id])
  orderItems    OrderItem[]
  payment       Payment?             // Relasi 1-to-1 ke Payment (karena orderId unique)
  histories     OrderStatusHistory[] // Relasi 1-to-many ke riwayat status
}

model OrderItem {
  id            Int   @id @default(autoincrement())
  orderId       Int
  serviceId     Int
  quantity      Int      @default(1)
  priceSnapshot Int  
  subtotal      Int  

  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service       Service  @relation(fields: [serviceId], references: [id])
}

model Payment {
  id           Int   @id @default(autoincrement())
  orderId      Int   @unique 
  amount       Int  
  method       String   
  paidAt       DateTime @default(now())
  receivedById Int   


  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  receivedBy   User     @relation(fields: [receivedById], references: [id])
}
model OrderStatusHistory {
  id          Int      @id @default(autoincrement())
  orderId     Int
  status      OrderStatus 
  changedById Int      
  changedAt   DateTime    @default(now())
  note        String?    


  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy   User        @relation(fields: [changedById], references: [id])
}
enum Role {
  ADMIN
  STAFF
}
enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}

enum PayStatus {
  UNPAID
  PAID
}